# Development image — runs the server via air for live-reload.
# Not for production use. Use Dockerfile for production builds.
FROM golang:1.25-alpine

RUN apk --no-cache add ca-certificates tzdata git curl

# Install air (live-reload). Pinned: air >= v1.67.1 requires Go >= 1.26, which
# this base image (and go.mod's `go 1.25.0`) predates. Bump alongside the base
# image, not on its own.
RUN go install github.com/air-verse/air@v1.67.0

WORKDIR /app

# Pre-download dependencies (cached unless go.mod/go.sum change)
COPY go.mod go.sum ./
RUN go mod download

# Source is mounted at runtime via docker-compose volume, not copied here.
# This keeps the image lean and lets air watch the live source tree.

EXPOSE 8080

CMD ["air", "-c", ".air.toml"]
